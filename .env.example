# Nunca deixe credenciais espalhadas pelo código. Concentre as credendiais em um arquivo que não deve subir no GitHub
# Adicione o .env no .gitignore
# Pense em criptografar o .env
# ===================================================================
# Exemplo de Variáveis de Ambiente (.env.example)
# Copie este arquivo para '.env' e preencha com suas credenciais reais.
# ===================================================================

# Configurações do Servidor
SERVER_PORT=8089

# Configurações do Banco de Dados
DB_URL=jdbc:mariadb://localhost:3306/mydb
DB_USERNAME=desenvolvedor
DB_PASSWORD=tua_senha_aqui
DB_DRIVER=com.mysql.cj.jdbc.Driver
